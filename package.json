{
  "name": "sharingan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sharingan/site dev",
    "registry": "node scripts/registry.mjs",
    "registry:local": "SHARINGAN_URL=http://localhost:3100 node scripts/registry.mjs",
    "build": "pnpm --filter @sharingan/site build",
    "check:registry": "node scripts/check-registry.mjs",
    "typecheck": "pnpm -r typecheck",
    "posters": "node scripts/posters.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.17.1",
  "license": "MIT"
}
